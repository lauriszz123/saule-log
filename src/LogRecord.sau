-- One thing logged: when, how much it matters, which logger said it, what
-- it said, and any values that go with it, by name.
--
--   log.info("window opened", {id: 3, title: "Settings"})
--
-- is a record with the message "window opened" and two fields.

from Level import Level

export class LogRecord
  -- When, in milliseconds since the epoch.
  time: integer

  level: Level

  -- The logger's name, e.g. "wm.session".
  source: string

  message: string

  -- Named values that go with the message; empty when there are none.
  fields: table

  fn init(
    time: integer,
    level: Level,
    source: string,
    message: string,
    fields: table
  )
    self.time = time
    self.level = level
    self.source = source
    self.message = message
    self.fields = fields
  end
end
